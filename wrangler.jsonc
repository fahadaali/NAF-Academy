// نشر أكاديمية ناف على Cloudflare Workers عبر OpenNext.
// المعرّفات (database_id / id) تُملأ بعد إنشاء الموارد: انظر README ← النشر.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naf-academy",
  "main": ".cf/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "naf_academy", "database_id": "b12360ab-1ce4-4ec0-96a4-5d1355cd95ff", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "naf-academy-media" }],
  // الرسائل الآلية: جدولة وإرسال كل 5 دقائق (scripts/cf-config.mjs يولّد معالج scheduled)
  "triggers": { "crons": ["*/5 * * * *"] },
  // القيم النصية (غير السرّية) هنا وحدها: كل نشر يستبدل متغيرات النص بما في هذا الملف،
  // فما يُضاف منها في لوحة Cloudflare يُحذف عند النشر التالي (فتُقفل قناة البريد بلا MAIL_FROM).
  // SMS_SENDER و VAPID_PUBLIC_KEY و VAPID_SUBJECT تُضاف هنا متى رُبطت قنواتها.
  "vars": {
    "SITE_URL": "https://academy.naflaw.sa",
    "MAIL_FROM": "أكاديمية ناف <academy@naflaw.sa>"
  }
  // الأسرار (wrangler secret put أو Secret في اللوحة — لا يمسّها النشر): MOYASAR_SECRET_KEY · MOYASAR_PUBLISHABLE_KEY · MOYASAR_WEBHOOK_SECRET
  // · RESEND_API_KEY · RESEND_WEBHOOK_SECRET · TAQNYAT_API_KEY · LEARNER_SECRET · ADMIN_SECRET · CRON_SECRET (24 حرفاً على الأقل)
  // · ADMIN_PASSWORD (كلمة مرور صفحة الإعداد /setup — ليست كلمة دخول اللوحة)
}
