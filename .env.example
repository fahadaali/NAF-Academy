# ── محلياً ──
DATABASE_URL=file:.data/academy.db
# دخول اللوحة بكلمة مرور (التطوير، أو مخرج طوارئ إن لم يُضبط الدخول الموحّد)
ADMIN_PASSWORD=
ADMIN_SECRET=            # 32 حرفاً عشوائياً على الأقل
LEARNER_SECRET=          # 32 حرفاً عشوائياً — توقيع رموز دخول المتدربين
# PAYMENTS_GATEWAY=mock  # بوابة تجريبية — تعمل في التطوير فقط، وممنوعة في الإنتاج

# ── الدفع (ميسر) ──
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# ── الرسائل ──
RESEND_API_KEY=
MAIL_FROM=               # أكاديمية ناف <no-reply@academy.naf.sa>
TAQNYAT_API_KEY=
SMS_SENDER=

# ── الدخول الموحّد لفريق ناف (naf-auth) ──
STAFF_AUTH=              # naf-auth لتفعيله
AUTH_ISSUER=             # عنوان مركز naf-id
PLATFORM_ID=naf-academy

# Cloudflare Stream — فيديو الدروس بروابط تشغيل موقّعة والرفع المباشر (مقفل حتى تُضاف)
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=          # رمز API بصلاحية Stream:Edit
CF_STREAM_CUSTOMER=       # الجزء بعد customer- في نطاق التشغيل

# الرسائل الآلية
SITE_URL=                 # رابط الموقع المطلق (https://…) — بدونه تتوقف الرسائل الآلية في الإنتاج
CRON_SECRET=              # 24 حرفاً على الأقل — يحمي /api/cron/notify

# إشعارات المتصفح (Web Push) — مقفلة حتى تُضاف
VAPID_PUBLIC_KEY=         # المفتاح العام (base64url، 65 بايت)
VAPID_PRIVATE_KEY=        # المفتاح الخاص (base64url، 32 بايت) — سرّ
VAPID_SUBJECT=            # mailto:academy@naf.sa

# تتبّع البريد (Resend webhooks: التسليم والفتح والارتداد والشكوى) — مقفل حتى يُضاف
RESEND_WEBHOOK_SECRET=    # سرّ Svix من إعدادات Webhooks في Resend (whsec_…)

# تسجيلات Zoom التلقائية — مقفلة حتى يُضاف السرّ وتُفعَّل من «الجلسات والحضور» (وتتطلب Stream)
ZOOM_WEBHOOK_SECRET=      # Secret Token لتطبيق Zoom (Event Subscriptions)
