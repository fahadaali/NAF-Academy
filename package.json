{
  "name": "naf-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run -s typecheck && npm run -s test",
    "predev": "node scripts/setup-fonts.mjs && tsx scripts/db-setup.ts",
    "prebuild": "node scripts/setup-fonts.mjs && tsx scripts/db-setup.ts",
    "pretypecheck": "node scripts/setup-fonts.mjs",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@emran-alhaddad/saudi-riyal-font": "^1.1.0",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.0.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
